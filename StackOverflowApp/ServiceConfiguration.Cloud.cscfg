<?xml version="1.0" encoding="utf-8"?>
<ServiceConfiguration serviceName="StackOverflowApp" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="6" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="StackOverflowService_WebRole">
    <Instances count="1" />
    <ConfigurationSettings />
  </Role>
  <NetworkConfiguration>
    <VirtualNetworkSite name="stackoverflowappVNet" />
    <AddressAssignments>
      <InstanceAddress roleName="StackOverflowService_WebRole">
        <Subnets>
          <Subnet name="WebTier" />
        </Subnets>
      </InstanceAddress>
    </AddressAssignments>
  </NetworkConfiguration>
</ServiceConfiguration>