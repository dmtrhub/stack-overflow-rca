<?xml version="1.0" encoding="utf-8"?>
<ServiceConfiguration serviceName="StackOverflowApp" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="6" osVersion="*" schemaVersion="2015-04.2.6">
	<Role name="StackOverflowService_WebRole">
		<Instances count="1" />
		<ConfigurationSettings />
	</Role>
	<Role name="HealthMonitoringService">
		<Instances count="2" />
		<ConfigurationSettings>
			<Setting name="DataConnectionString" value="UseDevelopmentStorage=true" />
			<Setting name="SmtpHost" value="smtp.gmail.com" />
			<Setting name="SmtpPort" value="587" />
			<Setting name="SmtpUser" value="dmtr.faculty@gmail.com" />
			<Setting name="SmtpPass" value="hafn rlyb qnae zbnt" />
			<Setting name="FromAddress" value="dmtr.faculty@gmail.com" />
		</ConfigurationSettings>
	</Role>
	<Role name="HealthStatusService">
		<Instances count="1" />
		<ConfigurationSettings>
			<Setting name="DataConnectionString" value="UseDevelopmentStorage=true" />
		</ConfigurationSettings>
	</Role>
	<NetworkConfiguration>
		<VirtualNetworkSite name="stackoverflowappVNet" />
		<AddressAssignments>
			<InstanceAddress roleName="StackOverflowService_WebRole">
				<Subnets>
					<Subnet name="WebTier" />
				</Subnets>
			</InstanceAddress>
			<InstanceAddress roleName="HealthMonitoringService">
				<Subnets>
					<Subnet name="WebTier" />
				</Subnets>
			</InstanceAddress>
			<InstanceAddress roleName="HealthStatusService">
				<Subnets>
					<Subnet name="WebTier" />
				</Subnets>
			</InstanceAddress>
		</AddressAssignments>
	</NetworkConfiguration>
</ServiceConfiguration>