@model HealthStatusService.Models.HealthCheckViewModel
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="text-center mb-4">
    <h1>Health Status Dashboard</h1>
    <p class="lead">Pregled dostupnosti servisa u poslednja 3 sata</p>
    <p><strong>Procentualna dostupnost StackOverflowService:</strong> @Model.AvailabilityPercent.ToString("F2")%</p>
</div>

<div class="row mb-4">
    <div class="col-md-8 mx-auto">
        <div class="chart-container" style="position: relative; height: 600px;">
            <canvas id="availabilityChart"></canvas>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Servis</th>
                <th>Status</th>
                <th>Datum i vreme</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.HealthChecks.Any())
            {
                int counter = 1;
                foreach (var hc in Model.HealthChecks)
                {
                    <tr class="@(hc.Status == "OK" ? "table-success" : "table-danger")">
                        <td>@counter</td>
                        <td>@hc.ServiceName</td>
                        <td>@hc.Status</td>
                        <td>@hc.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                    </tr>
                    counter++;
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">Nema podataka u poslednja 3 sata.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('availabilityChart').getContext('2d');
        const okCount = @Model.Ok;
        const notOkCount = @Model.NotOk;
        const totalCount = okCount + notOkCount;

        const data = {
            labels: ['Dostupan', 'Nedostupan'],
            datasets: [{
                label: 'Dostupnost servisa',
                data: [okCount, notOkCount],
                backgroundColor: ['#28a745', '#dc3545'],
                borderColor: ['#1e7e34', '#a71e2a'],
                borderWidth: 3,
                hoverOffset: 7
            }]
        };

        const config = {
            type: 'doughnut',
            data: data,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '50%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            font: {
                                size: 16,
                                weight: 'bold',
                                color: 'black'
                            },
                            padding: 20
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const value = context.raw;
                                const label = context.label;
                                const percent = totalCount > 0 ? ((value / totalCount) * 100).toFixed(1) : 0;
                                return `${label}: ${value} (${percent}%)`;
                            }
                        }
                    }
                }
            }
        };

        new Chart(ctx, config);
    </script>
}